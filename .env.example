# Copy to .env.local and fill in. Never commit real values.
# .env.local is gitignored; these are read on the server only and never reach
# the browser.
#
# On Vercel these go in Project Settings -> Environment Variables, not in a
# file: .env.local is not deployed.

# ---------------------------------------------------------------------------
# Contact form delivery (SMTP)
# ---------------------------------------------------------------------------
# Until SMTP_HOST, SMTP_USER, SMTP_PASS and CONTACT_TO_EMAIL are all set,
# POST /api/contact returns 503 and the form tells the visitor the message was
# NOT sent. It never shows a false confirmation.

# Your mail host's outgoing server. For Hostinger mailboxes this is
# smtp.hostinger.com — check the exact value in hPanel -> Emails -> your
# mailbox -> Configuration, as it differs for some plans.
SMTP_HOST=smtp.hostinger.com

# 465 uses implicit TLS, 587 upgrades an open connection with STARTTLS.
# Either works; 465 is the usual choice and is what the route assumes when
# this is unset.
SMTP_PORT=465

# The full mailbox address, e.g. hello@emergingfreelancer.com
SMTP_USER=

# That mailbox's password. This is the mailbox password, not your hosting
# account password, and not an app password unless your host issues one.
SMTP_PASS=

# ---------------------------------------------------------------------------
# Addresses
# ---------------------------------------------------------------------------

# Where enquiries land. Can be the same mailbox as SMTP_USER, or any address
# you actually read.
CONTACT_TO_EMAIL=

# The "from" address. Most hosts, Hostinger included, refuse to send as an
# address the authenticated mailbox does not own, so this should normally be
# the same as SMTP_USER. Left unset, the route uses SMTP_USER.
CONTACT_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Google reCAPTCHA v3 (invisible score)
# ---------------------------------------------------------------------------
# Create a score-based v3 key at https://www.google.com/recaptcha/admin
# and add both www.emergingfreelancer.com and emergingfreelancer.com.
# The site key is public. The secret stays on the server. There is no checkbox.
# In production the form refuses to send until RECAPTCHA_SECRET_KEY is set.
# Locally, with NODE_ENV=development, mail still sends if these are blank.

NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---------------------------------------------------------------------------
# Site address (optional)
# ---------------------------------------------------------------------------
# Canonical URLs, the sitemap and the generated share images are all built
# from this. It defaults to the production domain, so set it only when the
# site is being served somewhere else — a vercel.app preview, for instance —
# where leaving it would point every canonical at a domain that is not
# serving this build.
# NEXT_PUBLIC_SITE_URL=https://emergingfreelancer.com
